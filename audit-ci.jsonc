{
  // CI runs `audit-ci --moderate`, so advisories at moderate severity and above
  // fail the build. Keep this config self-consistent with that CLI flag.
  "moderate": true,
  "allowlist": [
    // GHSA-gv7w-rqvm-qjhr — esbuild: "Missing binary integrity verification in
    // the Deno module enables remote code execution via NPM_CONFIG_REGISTRY".
    // The flaw is specific to esbuild's Deno install path. This is an npm/Node
    // project where esbuild is a build-time-only devDependency installed with
    // package-lock integrity hashes, so the Deno binary-download vector is not
    // reachable. The only patched release (esbuild 0.28.1) is unsupported by
    // every current Vite release (Vite still pins esbuild ^0.25/^0.27) and
    // breaks the Vite web build, so it cannot be adopted yet.
    // Re-evaluate once Vite ships support for esbuild >=0.28.1. Review by 2026-09-01.
    "GHSA-gv7w-rqvm-qjhr"
  ]
}
