{
  "name": "teleton-agent-v2",
  "version": "2.0.0-alpha.2",
  "description": "Teleton: Autonomous AI Agent for Telegram & TON Blockchain — unified V1 + V2",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "teleton": "./bin/teleton.js"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "web"
  ],
  "scripts": {
    "preinstall": "npx only-allow npm",
    "prepare": "husky",
    "build": "npm run build:v2",
    "build:all": "npm run build:v1:sdk && npm run build:v1 && npm run build:v2 && npm run build:web",
    "build:v2": "npm run build:core && npm run build:infrastructure && npm run build:api && npm run build:sdk && npm run build:intelligence && npm run build:integrations && npm run build:agents && npm run build:security && npm run build:ui && npm run build:learning && npm run build:network && npm run build:apps",
    "build:v1": "tsup --config v1-src/tsup.config.ts",
    "build:v1:sdk": "cd packages/sdk-v1 && tsup",
    "build:web": "cd web && npm run build",
    "build:core": "tsup --config packages/core/tsup.config.ts",
    "build:infrastructure": "tsup --config packages/infrastructure/tsup.config.ts",
    "build:api": "tsup --config packages/api/tsup.config.ts",
    "build:sdk": "tsup --config packages/sdk/tsup.config.ts",
    "build:intelligence": "tsup --config packages/intelligence/tsup.config.ts",
    "build:integrations": "tsup --config packages/integrations/tsup.config.ts",
    "build:agents": "tsup --config packages/agents/tsup.config.ts",
    "build:security": "tsup --config packages/security/tsup.config.ts",
    "build:ui": "tsup --config packages/ui/tsup.config.ts",
    "build:learning": "tsup --config packages/learning/tsup.config.ts",
    "build:network": "tsup --config packages/network/tsup.config.ts",
    "build:apps": "tsup --config apps/agent/tsup.config.ts",
    "dev": "tsx apps/agent/src/index.ts",
    "dev:v1": "tsx v1-src/index.ts",
    "dev:web": "cd web && npm run dev",
    "start": "node dist/apps/agent/index.js",
    "start:v1": "node dist/cli/index.js start",
    "setup": "node dist/cli/index.js setup",
    "doctor:v1": "node dist/cli/index.js doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --strict",
    "security:audit": "audit-ci --moderate",
    "security:sca": "npm audit --production",
    "circular": "madge --circular --extensions ts src/",
    "unused": "knip",
    "doctor": "npm run typecheck && npm run lint && npm run test && npm run circular"
  },
  "overrides": {
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.4",
    "brace-expansion": "^1.1.13",
    "smol-toml": "^1.6.1",
    "vite": "^6.4.2",
    "micromatch": {
      "picomatch": "^2.3.2"
    }
  },
  "dependencies": {
    "@dedust/sdk": "^0.8.7",
    "@hono/node-server": "^1.19.13",
    "@huggingface/transformers": "^3.8.1",
    "@inquirer/prompts": "^8.2.1",
    "@mariozechner/pi-ai": "^0.58.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sinclair/typebox": "^0.34.48",
    "@tavily/core": "^0.7.2",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.2",
    "awilix": "^11.0.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.0",
    "grammy": "^1.40.0",
    "hono": "^4.12.12",
    "hono-rate-limiter": "^0.5.3",
    "lottie-react": "^2.4.1",
    "ora": "^9.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "selfsigned": "^5.5.0",
    "sqlite-vec": "^0.1.7",
    "telegram": "github:TONresistor/gramjs#34b6b63",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ston-fi/api": "^0.30.0",
    "@ston-fi/sdk": "^2.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.1.3",
    "audit-ci": "^7.0.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "knip": "^5.85.0",
    "lint-staged": "^16.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  }
}
